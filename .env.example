# ============================================================
#  Supabase 前端公开环境变量（只允许放“公开客户端”密钥）
#  复制本文件为 .env，填入你自己 Supabase 项目的值。
#  Vite 只会把以 VITE_ 开头的变量打进前端包。
# ============================================================

# 在 Supabase 控制台: Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://wvodyszxlnyvtmepfdoc.supabase.co
# 在 Supabase 控制台: Project Settings -> API -> Project API keys ->
#   "anon" "public" key（新版界面叫 publishable / sb_publishablekey）
# 这个 key 本来就是公开的，安全性完全由 RLS 与 Storage 策略保证。
VITE_SUPABASE_ANON_KEY=sb_publishable_f8Gu-uW9tHIrtZMVSBv7VQ_vUyR6_YV
# ------------------------------------------------------------
#  严禁放入本文件 / 前端的内容：
#   - service_role key（secret key）
#   - 数据库密码
#   - 任何管理员账号密码
# 这些只能存在于服务端环境变量，绝不进入前端包或 Git。
# ------------------------------------------------------------
